# Production settings. setup.sh copies this to server/.env (readable only by
# the app) and fills in the generated values. Never commit the real file.

# --- Required: add your key, then run deploy.sh -------------------------------
OPENAI_API_KEY=

# --- Generated by setup.sh -----------------------------------------------------
# Shared secret between the index server and the API
INDEX_SERVER_AUTHKEY=__AUTHKEY__
# Signs login cookies. Changing it logs everyone out.
FLASK_SECRET_KEY=__SECRET__

# --- Site --------------------------------------------------------------------
# Login cookies are only sent over HTTPS
SESSION_COOKIE_SECURE=true
ALLOWED_ORIGINS=https://__DOMAIN__
API_HOST=127.0.0.1
API_PORT=5601
# Caddy sits in front of the API: use the visitor's real address for rate limits
TRUSTED_PROXY_COUNT=1
INDEX_PORT=5602

# Shown in the Upgrade dialog (optional)
SUPPORT_EMAIL=

# --- Limits and free trial ------------------------------------------------------
MAX_UPLOAD_MB=50
TRIAL_DAYS=7
TRIAL_MAX_DOCUMENTS=10
TRIAL_MAX_QUESTIONS_PER_DAY=50

# --- Backups (optional) ----------------------------------------------------------
# Also copy nightly backups to a Lightsail/S3 bucket, e.g. s3://my-rag-backups
# (needs the AWS CLI configured for the root user; see the deployment guide)
BACKUP_BUCKET=
