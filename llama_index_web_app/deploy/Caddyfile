# Caddy config for the RAG app. setup.sh copies this to /etc/caddy/Caddyfile
# with your domain filled in. Caddy gets and renews the HTTPS certificate itself.

__DOMAIN__ {
	encode zstd gzip

	# Uploads up to MAX_UPLOAD_MB (50 MB) plus form overhead
	request_body {
		max_size 55MB
	}

	# API: /api/... is forwarded to Flask with the /api prefix removed
	handle_path /api/* {
		reverse_proxy 127.0.0.1:5601 {
			transport http {
				# Indexing and conversions can take a few minutes
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# Website: the built React app; unknown paths fall back to index.html
	handle {
		root * /opt/rag/app/llama_index_web_app/rag-web-app/build
		header /static/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	log {
		output file /var/log/caddy/rag-access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# www.yourdomain.com -> yourdomain.com
www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}
