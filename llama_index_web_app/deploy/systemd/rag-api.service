[Unit]
Description=RAG app - API (gunicorn + Flask)
# The API talks to the index server; restart together so its connection is fresh
Requires=rag-index.service
After=rag-index.service
PartOf=rag-index.service

[Service]
User=rag
Group=rag
WorkingDirectory=/opt/rag/app/llama_index_web_app/server
EnvironmentFile=/opt/rag/app/llama_index_web_app/server/.env
ExecStart=/opt/rag/app/llama_index_web_app/server/.venv/bin/gunicorn -c gunicorn.conf.py flask_demo:app
Restart=on-failure
RestartSec=5
UMask=0027

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
