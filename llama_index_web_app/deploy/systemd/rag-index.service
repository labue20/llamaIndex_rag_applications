[Unit]
Description=RAG app - index server (search index and documents)
After=network-online.target
Wants=network-online.target

[Service]
User=rag
Group=rag
WorkingDirectory=/opt/rag/app/llama_index_web_app/server
EnvironmentFile=/opt/rag/app/llama_index_web_app/server/.env
ExecStart=/opt/rag/app/llama_index_web_app/server/.venv/bin/python -u index_server.py
Restart=on-failure
RestartSec=5
# Files the app creates (accounts, index, uploads) aren't readable by other users
UMask=0027

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
