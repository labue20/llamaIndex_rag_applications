# Caddy config for Dokkiman. setup.sh copies this to /etc/caddy/Caddyfile
# with your domain filled in. Caddy gets and renews the HTTPS certificate itself.

__DOMAIN__ {
	encode zstd gzip

	# Uploads up to MAX_UPLOAD_MB (50 MB) plus form overhead
	request_body {
		max_size 55MB
	}

	# API: /api/... is forwarded to Flask with the /api prefix removed
	handle_path /api/* {
		reverse_proxy 127.0.0.1:5601 {
			transport http {
				# Indexing and conversions can take a few minutes
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# Website: the built React app. Each public page (the homepage, pricing,
	# legal pages and a page per tool, like /compress-pdf) has its own HTML file
	# (web/scripts/seo.js) for search engines and link previews. The app's own
	# addresses use index.html. Anything else is a real 404 (the app then shows
	# the homepage), so search engines don't index made-up addresses.
	@app_pages path / /login /signup /admin /app /app/* /sign/*
	handle @app_pages {
		root * /opt/dokkiman/app/dokkiman/web/build
		header Cache-Control "no-cache"
		try_files {path}/index.html /index.html
		file_server
	}

	handle {
		root * /opt/dokkiman/app/dokkiman/web/build
		@pages not path /static/*
		header @pages Cache-Control "no-cache"
		header /static/* Cache-Control "public, max-age=31536000, immutable"
		# A public page is served from its folder's index.html (/pricing ->
		# /pricing/index.html), without redirecting to /pricing/
		try_files {path} {path}/index.html
		file_server
	}

	handle_errors 404 {
		root * /opt/dokkiman/app/dokkiman/web/build
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	# Keep private and app pages out of search results
	@noindex path /app /app/* /admin /login /signup /sign/*
	header @noindex X-Robots-Tag "noindex, nofollow"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Only this site's own code may run, plus Google sign-in; styles and fonts
		# from Google Fonts; blob: for in-browser PDF previews and downloads.
		# Tested with every tool (see the CSP note in docs/DEPLOY_AWS_LIGHTSAIL.md).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.googleusercontent.com; connect-src 'self' blob: https://accounts.google.com/gsi/; frame-src 'self' blob: https://accounts.google.com/gsi/; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	log {
		output file /var/log/caddy/dokkiman-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		# Signing links let whoever has them sign: keep their tokens out of the log
		format filter {
			request>uri regexp "(/sign(?:ing)?/)[A-Za-z0-9_-]{20,}" "${1}[token]"
			request>headers>Referer regexp "(/sign(?:ing)?/)[A-Za-z0-9_-]{20,}" "${1}[token]"
		}
	}
}

# www.yourdomain.com -> yourdomain.com
www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}
