# Production settings. setup.sh copies this to server/.env (readable only by
# the app) and fills in the generated values. Never commit the real file.

# --- Required: add your key, then run deploy.sh -------------------------------
OPENAI_API_KEY=

# --- Generated by setup.sh -----------------------------------------------------
# Shared secret between the index server and the API
INDEX_SERVER_AUTHKEY=__AUTHKEY__
# Signs login cookies. Changing it logs everyone out.
FLASK_SECRET_KEY=__SECRET__

# --- Site --------------------------------------------------------------------
# Login cookies are only sent over HTTPS
SESSION_COOKIE_SECURE=true
ALLOWED_ORIGINS=https://__DOMAIN__
API_HOST=127.0.0.1
API_PORT=5601
# Caddy sits in front of the API: use the visitor's real address for rate limits
TRUSTED_PROXY_COUNT=1
INDEX_PORT=5602

# Shown in the Upgrade dialog (optional)
SUPPORT_EMAIL=

# --- Sign-in --------------------------------------------------------------------
# Required: people sign in and start their trial with Google. Create the client
# ID in Google Cloud Console (see the deployment guide, "Set up Google sign-in").
# It isn't secret (the browser sees it), but it only works on the origins you list.
GOOGLE_CLIENT_ID=
# Leave false in production: email + password is for local development only
PASSWORD_LOGIN_ENABLED=false

# --- Email (E-Sign signature requests) ------------------------------------------------
# Resend API key (resend.com). Verify dokkiman.com in Resend first (DNS records at
# Namecheap). Empty = emails are written to the log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Dokkiman <sign@__DOMAIN__>"
# Signature requests per month (-1 = unlimited)
SIGNATURE_REQUESTS_PER_MONTH_TRIAL=3
SIGNATURE_REQUESTS_PER_MONTH_FREE=0
SIGNATURE_REQUESTS_PER_MONTH_BASIC=3
SIGNATURE_REQUESTS_PER_MONTH_PRO=-1

# --- Payments (optional) -----------------------------------------------------------
# Basic and Pro subscriptions with Stripe. Empty = "email us to upgrade". Use a restricted
# live key (rk_live_...) with only the permissions listed in the deployment guide.
# STRIPE_MODE=live uses STRIPE_SECRET_KEY; test mode (the default) uses STRIPE_SECRET_TEST_KEY.
STRIPE_MODE=live
STRIPE_SECRET_KEY=
# Printed by: stripe_setup.py --webhook-url https://__DOMAIN__/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
PUBLIC_APP_URL=https://__DOMAIN__
BASIC_PRICE_MONTHLY=1.99
BASIC_PRICE_YEARLY=19.99
PRO_PRICE_MONTHLY=9.99
PRO_PRICE_YEARLY=90
# Basic caps (Pro has none; conversions are unlimited on both)
BASIC_MAX_DOCUMENTS=25
BASIC_MAX_QUESTIONS_PER_DAY=50

# --- Limits and free trial ------------------------------------------------------
MAX_UPLOAD_MB=50
TRIAL_DAYS=30
TRIAL_MAX_DOCUMENTS=10
TRIAL_MAX_QUESTIONS_PER_DAY=50

# --- Backups (optional) ----------------------------------------------------------
# Also copy nightly backups to a Lightsail/S3 bucket, e.g. s3://my-dokkiman-backups
# (needs the AWS CLI configured for the root user; see the deployment guide)
BACKUP_BUCKET=
